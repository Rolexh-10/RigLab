# The trial build (dist/riglab.html) needs NO environment variables.
# These are for the planned Next.js + PostgreSQL phase. Never commit a real .env.

DATABASE_URL="postgresql://riglab:change-me@localhost:5432/riglab"
AUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_URL="http://localhost:3000"

# Analytics (leave empty to disable; events: build_started, build_completed, build_shared, store_clicked)
NEXT_PUBLIC_GA4_ID=""

# Error monitoring (optional)
SENTRY_DSN=""

# Object storage for store CSV uploads (later phase)
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# Default market. Only IQ has real-price support at launch.
DEFAULT_MARKET="IQ"
