{
  "name": "riglab",
  "version": "0.4.0",
  "private": true,
  "description": "RigLab: Iraqi-first PC builder, compatibility checker and hardware tools (trial build, sample data)",
  "scripts": {
    "build": "node scripts/build.js",
    "typecheck": "tsc -p .",
    "test": "node --import tsx --test tests/unit/*.test.js tests/ui/*.test.js",
    "test:unit": "node --import tsx --test tests/unit/*.test.js",
    "test:ui": "npm run build && node --import tsx --test tests/ui/*.test.js",
    "serve": "node scripts/serve.js",
    "test:db": "node --import tsx --test tests/db/*.test.js",
    "db:seed": "node --import tsx scripts/gen-seed.ts > db/seed.sql"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.25.0",
    "playwright": "^1.50.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
