{
  "name": "riglab",
  "version": "0.2.0",
  "private": true,
  "description": "RigLab: Iraqi-first PC builder, compatibility checker and hardware tools (trial build, sample data)",
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node --test tests/unit/*.test.js tests/ui/*.test.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:ui": "npm run build && node --test tests/ui/*.test.js",
    "serve": "node scripts/serve.js"
  },
  "devDependencies": {
    "playwright": "^1.50.0"
  }
}