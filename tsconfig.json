{
  "compilerOptions": {
    "target": "ES2020", "module": "ESNext", "moduleResolution": "bundler", "lib": ["ES2020"],
    "strict": true, "noEmit": true, "skipLibCheck": true, "noImplicitReturns": true, "noFallthroughCasesInSwitch": true,
    "types": []
  },
  "include": ["src/core/**/*.ts", "src/data/**/*.ts", "src/repo/**/*.ts", "src/ingest/**/*.ts"]
}
