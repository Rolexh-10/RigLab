{
  "compilerOptions": {
    "target": "ES2020", "lib": ["dom", "dom.iterable", "ES2020"], "module": "esnext", "moduleResolution": "bundler",
    "jsx": "preserve", "strict": true, "noEmit": true, "skipLibCheck": true, "allowJs": false, "incremental": true, "isolatedModules": true,
    "plugins": [{ "name": "next" }],
    "paths": { "@riglab/core": ["../src/core/index.ts"], "@riglab/data": ["../src/data/index.ts"] }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
